# Copiar a .env (opcional; compose ya trae defaults SOLO para local).
# NUNCA subir secretos reales al repo. En producción todas estas variables
# se definen en el dashboard de Render (ver render.yaml + README §6).
#
# Secreto HMAC compartido (OBLIGATORIO cambiarlo en producción,
# ambos servicios arrancan en fail-fast si sigue el valor de ejemplo).
# Generar con: openssl rand -hex 32
JWT_SECRET=supersecret-reto-tecnico

# Identificadores del token: deben coincidir en Go y Node.
JWT_ISSUER=reto-tecnico
JWT_AUDIENCE=reto-tecnico-apis

# Desactivar el emisor demo de tokens en despliegues públicos:
# ENABLE_DEMO_TOKEN=false
ENABLE_DEMO_TOKEN=true

# CORS: origen permitido ('*' solo para desarrollo local).
CORS_ORIGIN=*

# Rate limit de /api/* (Go usa duración "1m"; Node usa ms "60000").
RATE_LIMIT_MAX=100

# Tope anti-DoS de elementos por request (Gram-Schmidt es O(m·n²)).
MAX_MATRIX_ELEMENTS=10000

# Solo api-go: URL pública/privada de la API de Node.
# En compose es el nombre del servicio; en Render, la URL pública de reto-api-node.
NODE_API_URL=http://api-node:3002/api/stats
